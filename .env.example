# Local development (SQLite is used when DATABASE_URL is empty or unset)
SECRET_KEY=replace-this-with-a-random-secret-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Leave DATABASE_URL empty for SQLite during local testing.
DATABASE_URL=

# Production example (use your hosting provider's private database credentials).
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# DEBUG=0
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
# SECURE_SSL_REDIRECT=1

# Optional: Redis enables cross-process WebSocket delivery.
# REDIS_URL=redis://127.0.0.1:6379/0
