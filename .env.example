# .env.example — কপি করে .env নাম দিন এবং নিজের মান বসান। .env কখনো গিটে পুশ করবেন না।
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (খালি রাখলে ডেভেলপমেন্টে SQLite ব্যবহার হবে)
DATABASE_URL=postgres://ordermama:password@localhost:5432/ordermama

# Redis (খালি রাখলে ডেভেলপমেন্টে In-Memory channel layer ব্যবহার হবে; প্রোডাকশনে Redis আবশ্যক)
REDIS_URL=redis://localhost:6379/0

# Redis দেওয়া আছে কিন্তু চালু নেই — প্রোডাকশনে অ্যাপ চালু হবে না। শুধু একক-প্রসেসে মেমরিতে নামতে চাইলে True
ALLOW_REDIS_FALLBACK=False

# সামনে কয়টি রিভার্স-প্রক্সি (nginx/Apache) আছে। ডেভে 0, প্রোডাকশনে সাধারণত 1; প্রক্সি ছাড়া সরাসরি খুললে 0
NUM_PROXIES=0

# QR কোডে যে ডোমেইন বসবে
SITE_BASE_URL=http://localhost:8000

# পেমেন্ট গেটওয়ে: mock, manual, sslcommerz অথবা both (manual + SSLCommerz)
PAYMENT_GATEWAY=both
# Manual Payment গ্রহণের নম্বর — ব্যক্তিগত নম্বর .env-এ রাখুন, GitHub-এ নয়
MANUAL_BKASH_NUMBER=
MANUAL_NAGAD_NUMBER=
MANUAL_ROCKET_NUMBER=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=True

# প্রোডাকশনে HTTPS চালু থাকলে (nginx/প্রক্সির পেছনে) এগুলো চালু করুন
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# cPanel/Passenger-এ আপলোড করা ছবি Django দিয়েই সার্ভ করতে চাইলে True (ডেডিকেটেড সার্ভারে nginx ব্যবহার করুন)
SERVE_MEDIA=False
