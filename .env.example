# Copy to .env and edit. Never commit .env.
SECRET_KEY=replace-this-with-a-long-random-secret-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# ---- Database -------------------------------------------------------------
# Leave EMPTY to use the local SQLite file (db.sqlite3).
DATABASE_URL=
# To switch to PostgreSQL later, just fill it in (no code changes):
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# DATABASE_SSL_REQUIRE=0

# ---- Production example ---------------------------------------------------
# DEBUG=0
# ALLOWED_HOSTS=ordermama.notte.top
# CSRF_TRUSTED_ORIGINS=https://ordermama.notte.top
# SITE_URL=https://ordermama.notte.top
# SECURE_SSL_REDIRECT=1

# ---- Real-time ------------------------------------------------------------
# The kitchen screen always polls (works on cPanel). A WebSocket is used too
# when the server supports it (needs ASGI + optionally Redis).
LIVE_POLL_SECONDS=5
# REDIS_URL=redis://127.0.0.1:6379/0

# ---- Subscriptions & manual bKash / Nagad payments -------------------------
# 0 = restaurants without a plan keep working. Set to 1 once plans exist.
ENFORCE_SUBSCRIPTIONS=0
SUBSCRIPTION_ALERT_DAYS=7
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=

# ---- E-mail (expiry alerts). Default prints to the console. ---------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.your-domain.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=OrderMama <no-reply@your-domain.com>
