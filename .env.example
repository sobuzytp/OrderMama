# .env.example — কপি করে .env নাম দিন এবং নিজের মান বসান। .env কখনো গিটে পুশ করবেন না।
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (খালি রাখলে ডেভেলপমেন্টে SQLite ব্যবহার হবে)
DATABASE_URL=postgres://ordermama:password@localhost:5432/ordermama

# Redis (খালি রাখলে ডেভেলপমেন্টে In-Memory channel layer ব্যবহার হবে; প্রোডাকশনে Redis আবশ্যক)
REDIS_URL=redis://localhost:6379/0

# QR কোডে যে ডোমেইন বসবে
SITE_BASE_URL=http://localhost:8000

# পেমেন্ট গেটওয়ে: mock (ডেভ) অথবা sslcommerz
PAYMENT_GATEWAY=mock
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=True

# প্রোডাকশনে HTTPS চালু থাকলে (nginx/প্রক্সির পেছনে) এগুলো চালু করুন
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
